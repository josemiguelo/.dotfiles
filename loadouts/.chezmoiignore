.config/zsh/.zplugins.zsh.zwc
.config/zsh/.zplugins.zsh.zwc.old
.config/zsh/.zcompdump

# The nvim config's README and license stay in the source, out of $HOME.
.config/nvim/README.md
.config/nvim/LICENSE

# mise's conf.d: off machines that aren't Omarchy, whole, or chezmoi still
# creates it (empty) around the ignored files. (Omarchy's agents lived here
# until Omarchy 4.5 declared them itself, in /etc/mise/conf.d; on Omarchy the
# folder stays, so .chezmoiremove reaches their file.)
{{ if not (includeTemplate "loadout/machine" . | fromJson).omarchy }}
.config/mise/conf.d
.config/mise/conf.d/**
{{ end }}

# fcitx5 is Omarchy's input method: its settings are for Omarchy machines only.
{{ if not (includeTemplate "loadout/machine" . | fromJson).omarchy }}
.config/fcitx5
.config/fcitx5/**
{{ end }}

# Switching between the machine's dark and light Omarchy theme.
{{ if not (includeTemplate "loadout/machine" . | fromJson).omarchy }}
.local/bin/omarchy-theme-mode-toggle
{{ end }}

# Setting the focused workspace's layout, for the Omarchy menu's entries.
{{ if not (includeTemplate "loadout/machine" . | fromJson).omarchy }}
.local/bin/omarchy-workspace-layout-set
{{ end }}

# Spotify's launch flags work around a crash under Omarchy's Wayland session.
{{ if not (includeTemplate "loadout/machine" . | fromJson).omarchy }}
.config/spotify-flags.conf
{{ end }}

# Raycast is a macOS app: its script commands land only on macOS.
{{ if ne .chezmoi.os "darwin" }}
.config/raycast
{{ end }}

# ngrok reads ~/Library/Application Support/ngrok on macOS, not ~/.config.
{{ if eq .chezmoi.os "darwin" }}
.config/ngrok
.config/ngrok/**
{{ end }}

# ~/.claude and ~/.codex are the agents' own: their source folders hold only
# loadout's manifests and scripts, so chezmoi leaves both folders alone.
.claude
.claude/**
.codex
.codex/**
