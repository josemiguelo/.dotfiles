app "linux commands" {
  meta { owl: 8; description: "The Linux Command Library: 9,000+ commands with examples and options, cheat sheets and terminal tips"; version: "1.5"; license: "MIT"; category: "dev" }
  title: sel != "" ? sel : basic != "" ? get(titles, basic, basic) : "linux commands"
  // Back goes from a page to the one before it (a command's "see also" chain), then to the list.
  back: sel != "" || basic != ""
  onBack: { was = sel == "" || prev == "" || url == "commands/${prev}.md" ? null : page; url = sel == "" || prev == "" ? url : "commands/${prev}.md"; basic = ""; sel = prev; back = drop(back, 1); copied = "" }
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#E0AF68"/>
    <path d="M128 36c-30 0-44 24-44 54 0 18-30 46-30 86 0 20 12 34 30 38h88c18-4 30-18 30-38 0-40-30-68-30-86 0-30-14-54-44-54z" fill="#1A1B26"/>
    <path d="M128 104c-24 0-34 26-34 56s12 50 34 50 34-20 34-50-10-56-34-56z" fill="#F4F4F4"/>
    <ellipse cx="112" cy="74" rx="11" ry="14" fill="#F4F4F4"/>
    <ellipse cx="144" cy="74" rx="11" ry="14" fill="#F4F4F4"/>
    <circle cx="114" cy="78" r="5" fill="#1A1B26"/>
    <circle cx="142" cy="78" r="5" fill="#1A1B26"/>
    <path d="M106 94c8-6 36-6 44 0-6 12-14 16-22 16s-16-4-22-16z" fill="#FF9E3B"/>
    <path d="M56 214c4-18 22-30 40-22 8 4 8 16 0 22zM200 214c-4-18-22-30-40-22-8 4-8 16 0 22z" fill="#FF9E3B"/>
  </svg>"""

  let TIPS = "tips.md"

  state tab = "commands" persist
  // The Linux Command Library app's own tab icons.
  asset puzzle = base64""
  asset idea = base64""
  asset search = base64""
  state q = ""
  // The command or basics page shown ("" for the lists), and the commands to go back to.
  state sel = ""
  state basic = ""
  state back = []
  // The page being read, a path in the Linux Command Library's assets; setting it fetches it. Until
  // the new page arrives, `was` holds the one it replaces, so the old page never shows under the new name.
  state url = "tips.md"
  state was = null
  state copied = ""

  source idx = http("https://raw.githubusercontent.com/SimonSchubert/LinuxCommandLibrary/master/assets/commands/index.txt") every 24h timeout 20s
  source bidx = http("https://raw.githubusercontent.com/SimonSchubert/LinuxCommandLibrary/master/assets/basics/index.txt") every 24h timeout 15s
  // Installed packages, when Linux is: libraries and language modules are left out, so the
  // list stays under owl's 1000 items. Packages with a page in the library show on the start page.
  source pkgs = cmd("pacman -Qq | grep -Ev '^(lib|python-|perl-|lua-|ruby-|node-|haskell-|ttf-|otf-|noto-|xorg-|qt[56]-|gst)'") every 10m optional
  // The one URL that changes: a page under the same assets folder as the indexes.
  source page = http("https://raw.githubusercontent.com/SimonSchubert/LinuxCommandLibrary/master/assets/${url}") every 24h timeout 15s status

  let ready = page != null && page != was
  let doc = ready && page.ok ? page.out : ""

  // The index has 9,000+ lines and lists stop at 1000, so it's searched as one text.
  let qq = replace(trim(q), '\E', "")
  let starts = qq == "" || idx == null ? [] : matchAll(idx, '(?im)^\Q' + qq + '\E[^\n]*(?=\.md$)')
  let inside = qq == "" || idx == null ? [] : matchAll(idx, '(?im)^[^\n]+\Q' + qq + '\E[^\n]*(?=\.md$)').filter(n => !startsWith(lower(n), lower(qq)))
  let exact = starts.filter(n => lower(n) == lower(qq))
  let hits = (exact + starts.filter(n => lower(n) != lower(qq)).sort() + inside.sort()).take(80)
  let names = idx == null ? "" : "\n${idx}\n"
  let mine = pkgs == null || idx == null ? [] : lines(pkgs).filter(p => contains(names, "\n${trim(p)}.md\n")).map(p => trim(p))
  let popular = ["tar", "grep", "find", "ssh", "git", "curl", "sed", "awk", "rsync", "systemctl", "pacman", "chmod", "ps", "ffmpeg", "tmux", "journalctl"]

  // A command page: its sections in the order the app shows them.
  let FIRST = ["TLDR", "NAME", "SYNOPSIS", "DESCRIPTION", "PARAMETERS", "OPTIONS", "EXAMPLES", "CONFIGURATION"]
  let LAST = ["INSTALL", "CAVEATS", "HISTORY", "AUTHOR", "SEE ALSO", "RESOURCES"]
  let secs = sel == "" ? [] : split("\n" + doc, "\n# ").drop(1).map(s => match(s, '^([^\n]*)\n?([\s\S]*)$'))
  let tagline = trim((secs.find(s => s[0] == "TAGLINE") ?? ["", ""])[1])
  let shown = secs.filter(s => s[0] != "TAGLINE" && trim(s[1]) != "").sortBy(s => indexOf(FIRST, s[0]) >= 0 ? indexOf(FIRST, s[0]) : indexOf(LAST, s[0]) >= 0 ? 89 + indexOf(LAST, s[0]) : 50)
  let prev = first(back) ?? ""

  let titles = {aitools: "AI tools", backupimaging: "Backup & Imaging", compressionarchiving: "Compression & Archiving", cryptocurrencies: "Cryptocurrencies", emacstexteditor: "Emacs Text Editor", filesfolders: "Files & Folders", git: "Git", hackingtools: "Hacking tools", input: "Input", json: "JSON", microtexteditor: "Micro Text Editor", nanotexteditor: "Nano Text Editor", network: "Network", oneliners: "One-liners", packagemanager: "Package manager", picotexteditor: "Pico Text Editor", printing: "Printing", regularexpressions: "Regular Expressions", searchfind: "Search & Find", shellscripting: "Shell Scripting", ssh: "SSH", systemcontrol: "System control", systeminformation: "System information", systemrecovery: "System Recovery", terminalgames: "Terminal games", textprocessing: "Text Processing", tmux: "Tmux", usersgroups: "Users & Groups", videoaudio: "Video & Audio", vimtexteditor: "VIM Text Editor"}
  let basics = bidx == null ? [] : lines(bidx).map(l => replace(trim(l), ".md", "")).sortBy(b => lower(get(titles, b, b)))

  // A tab of the bottom bar, as in the mobile app: an icon in a pill when it's the one open, and its name.
  component Tab(name, icon) {
    Column {
      weight: 1
      align: center
      gap: 4
      padding: [0, 6]
      onTap: { tab = name; sel = ""; basic = ""; back = []; was = name != "tips" || url == TIPS ? null : page; url = name == "tips" ? TIPS : url; haptic() }
      Box {
        align: center
        width: 64
        height: 32
        Image { src: icon; size: 24; tint: tab == name ? foreground : muted }
      }
      Text { text: name; style: small; align: center; maxLines: 1; bold: tab == name; color: tab == name ? foreground : muted }
    }
  }

  // A command name that opens its page; from a command page, back returns to it.
  component Chip(name, push = false) {
    Text {
      text: name; font: mono; style: small; align: center; maxLines: 1; width: len(name) * 8 + 22; padding: [0, 6]; radius: 3 * corners
      background: alpha(foreground, 0.06)
      onTap: { back = push ? [sel] + back : []; was = url == "commands/${name}.md" ? null : page; url = "commands/${name}.md"; sel = name; copied = "" }
    }
  }

  // One line of a page, or one ``` block, with the markdown taken out.
  component Block(b, flags = false, install = false) {
    let unlinked = join(matchAll(b, '\[([^\]]*)\]\([^)]*\)|([^\[]+|\[)').map(m => m[0] + m[1]), "")
    let plain = join(matchAll(unlinked, '[^*_`]+|(?<!\*)\*(?!\*)|(?<=[A-Za-z0-9])_(?=[A-Za-z0-9])'), "")
    // A table's |---| line under its header is left out.
    let kind = startsWith(b, "```") ? "code" : startsWith(b, "|") ? (match(b, '^[|:\- ]+$') == null ? "row" : "rule") : startsWith(b, "> ") ? "option" : startsWith(b, "## ") ? "heading" : startsWith(b, "- ") ? "bullet" : flags && startsWith(b, "**") ? "flag" : "text"
    let code = match(unlinked, '^```(?:[a-z]*\n)?([\s\S]*?)\n?```$')[0] ?? unlinked
    // An install line reads "pacman: sudo pacman -S tar"; only the command is copied.
    let cmd = install ? match(code, '^[\w-]+: (.*)$')[0] ?? code : code
    let cells = split(trim(plain), "|")
    if kind == "code" {
      Text {
        text: code; font: mono; style: small; fill: width; padding: [10, 8]; radius: 4 * corners
        color: copied == cmd ? accent : foreground
        background: copied == cmd ? alpha(accent, 0.12) : alpha(foreground, 0.06)
        onTap: { copy(cmd); copied = cmd; haptic() }
      }
    }
    if kind == "row" {
      Row {
        gap: 10
        align: top
        for c in cells.drop(1).take(max(len(cells) - 2, 0)) { Text { text: trim(c); style: small; weight: 1 } }
      }
    }
    if kind == "option" { Text { text: trim(drop(plain, 2)); color: muted; padding: [16, 0, 0, 4] } }
    if kind == "heading" { Text { text: trim(drop(plain, 3)); bold: true; padding: [0, 10, 0, 0] } }
    if kind == "bullet" { Text { text: "•  ${trim(drop(plain, 2))}"; padding: [8, 0, 0, 0] } }
    if kind == "flag" { Text { text: plain; font: mono; color: accent } }
    if kind == "text" { Text { text: plain } }
  }

  component Body(md, flags = false, install = false) {
    Column {
      gap: 8
      fill: width
      // Fenced blocks (one line or several), then every other line; page titles and comments are left out.
      // Install lines put Arch's first.
      for b in matchAll(md, '```[^`\n]*\n[\s\S]*?\n```|```[^\n]*?```|[^\n]+').filter(l => !startsWith(l, "# ") && !startsWith(l, "<!--")).sortBy(l => install && !startsWith(l, "```pacman") ? 1 : 0) {
        Block { b: b; flags: flags; install: install }
      }
    }
  }

  component Status() {
    if !ready {
      Text { text: "loading…"; color: muted }
    } else {
      if !page.ok {
        Text { text: page.code > 0 ? "couldn't load the page (HTTP ${page.code})" : "offline: the pages come from GitHub"; color: muted }
        Button { text: "try again"; onTap: refresh() }
      }
    }
  }

  Column {
    fill: true
    gap: 0
    // The pages keep a margin; the bar below runs to the screen's edges.
    Column {
      weight: 1
      gap: 10
      padding: [12, 0, 12, 10]
      if tab == "commands" && sel == "" {
        Row {
          align: center
          Input { text: q; placeholder: "search commands"; weight: 1; onChange: { q = value; copied = "" } }
          if q != "" {
            Text { text: "✕"; color: muted; width: 32; align: center; onTap: q = "" }
          }
        }
        Column {
          scroll: true
          weight: 1
          gap: 2
          if idx == null {
            Text { text: "loading the command list…"; color: muted }
          } else {
            if qq == "" {
              Text { text: len(mine) > 0 ? "installed (${len(mine)})" : "popular"; style: label; color: muted; padding: [0, 6, 0, 4] }
              Flow {
                gap: 6
                for n in len(mine) > 0 ? mine : popular key n { Chip { name: n } }
              }
            } else {
              if len(hits) == 0 {
                Text { text: "no command matches “${qq}”"; color: muted }
              }
              for n in hits key n {
                Text { text: n; font: mono; fill: width; maxLines: 1; padding: [4, 9]; onTap: { back = []; was = url == "commands/${n}.md" ? null : page; url = "commands/${n}.md"; sel = n; copied = "" } }
              }
            }
          }
        }
      }

      if tab == "commands" && sel != "" {
        Column {
          scroll: true
          weight: 1
          gap: 10
          Status { }
          if ready && page.ok {
            if tagline != "" {
              Text { text: tagline; color: muted }
            }
            for s in shown key s[0] {
              Text { text: lower(s[0]); style: label; color: accent; padding: [0, 10, 0, 0] }
              if s[0] == "SEE ALSO" {
                Flow {
                  gap: 6
                  for l in matchAll(s[1], '\[([^\]]+)\]\(/man/([^)]+)\)') { Chip { name: l[1]; push: true } }
                }
              }
              if s[0] == "RESOURCES" {
                for l in matchAll(s[1], '\[([^\]]+)\]\((https?://[^)\s]+)\)') {
                  Text { text: "${l[0]} ↗"; color: accent; padding: [0, 4]; onTap: url(l[1]) }
                }
              }
              if s[0] != "SEE ALSO" && s[0] != "RESOURCES" {
                Body { md: s[1]; flags: s[0] == "PARAMETERS" || s[0] == "OPTIONS"; install: s[0] == "INSTALL" }
              }
            }
          }
        }
      }

      if tab == "basics" && basic == "" {
        Column {
          scroll: true
          weight: 1
          gap: 2
          if bidx == null {
            Text { text: "loading…"; color: muted }
          }
          for b in basics key b {
            Text { text: get(titles, b, b); fill: width; maxLines: 1; padding: [4, 10]; onTap: { was = url == "basics/${b}.md" ? null : page; url = "basics/${b}.md"; basic = b; copied = "" } }
          }
        }
      }

      if tab == "basics" && basic != "" {
        Column {
          scroll: true
          weight: 1
          gap: 10
          Status { }
          if ready && page.ok {
            Body { md: doc }
          }
        }
      }

      if tab == "tips" {
        Column {
          scroll: true
          weight: 1
          gap: 10
          Status { }
          if ready && page.ok {
            Body { md: doc }
          }
        }
      }
    }

    Box { height: 1; fill: width; background: alpha(muted, 0.25) }
    Row {
      gap: 0
      Tab { name: "basics"; icon: puzzle }
      Tab { name: "tips"; icon: idea }
      Tab { name: "commands"; icon: search }
    }
  }
}
