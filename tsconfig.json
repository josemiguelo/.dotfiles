{
  // Bun's recommended settings, for the editor's TypeScript server on
  // loadout's Bun scripts. Types come from `bun install` (node_modules,
  // not committed); the scripts themselves run without it.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "types": ["bun"]
  },
  // The scripts live in dot folders (.loadout/), which a bare ** skips.
  "include": ["lib/*.ts", "loadouts/**/.loadout/**/*.ts", "loadouts/**/.*/.loadout/**/*.ts"]
}
