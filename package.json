{
  "name": "dotfiles-scripts",
  "private": true,
  "description": "loadout's Bun scripts: their shared modules by name (imports, read by Bun and by the editor), and type definitions for the editor only (bun install); the scripts run without installing anything.",
  "imports": {
    "#brew": "./lib/brew.ts",
    "#bare-repo": "./lib/bare-repo.ts",
    "#ssh": "./loadouts/.ssh/.loadout/lib/ssh.ts",
    "#antidote": "./loadouts/private_dot_config/zsh/.loadout/lib/antidote.ts",
    "#android-sdk": "./loadouts/private_dot_config/.android-sdk/.loadout/lib/android-sdk.ts",
    "#hypr": "./loadouts/private_dot_config/.omarchy/.loadout/lib/hypr.ts",
    "#omarchy": "./loadouts/private_dot_config/.omarchy/.loadout/lib/omarchy.ts",
    "#webapp": "./loadouts/private_dot_config/.omarchy/.loadout/lib/webapp.ts",
    "#nvim": "./loadouts/private_dot_config/nvim/.loadout/lib/nvim.ts",
    "#tmux": "./loadouts/private_dot_config/tmux/.loadout/lib/tmux.ts",
    "#onepassword": "./loadouts/private_dot_config/.1password/.loadout/lib/onepassword.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
