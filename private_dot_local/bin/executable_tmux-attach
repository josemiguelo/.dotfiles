#!/usr/bin/env bash

# tmux runs this through run-shell, which hands it tmux's environment rather
# than an interactive shell's, so FZF_DEFAULT_OPTS is not set. Load it here;
# fzf-tmux forwards the variable into the popup it opens.
source "${XDG_CONFIG_HOME:-$HOME/.config}/fzf/theme.sh"

# The C-M-a binding passes the active pane's directory (run-shell doesn't run us
# there). Move into it so `git worktree list` below sees the current repo.
[[ -n "$1" && -d "$1" ]] && cd "$1"

# Icons for differentiation (Nerd Fonts)
session_icon=""
dir_icon="󰉋"
worktree_icon=""

# 1. Collect existing sessions, excluding the per-session floating scratch
# sessions. The current session is kept in the list on purpose — it's easy to
# forget you're already in the session you're looking for.
sessions_raw=$(tmux list-sessions -F "#S" 2>/dev/null | grep -vE '^floating-')
if [[ -n "$TMUX" ]]; then
  current_session=$(tmux display-message -p '#S' 2>/dev/null)
fi

if [[ -n "$sessions_raw" ]]; then
  sessions=$(echo "$sessions_raw" | sed "s|^|$session_icon |")
else
  sessions=""
fi

# All existing session names, for de-duplicating dirs (and worktrees, later)
# below. workmux (nerdfont: true) names worktree sessions "<glyph> <name>", so
# a match is either the exact name or that glyph-prefixed " <name>" suffix.
open_names=$(tmux list-sessions -F '#S' 2>/dev/null)
_has_session_for() {
  local target="$1" sname
  while IFS= read -r sname; do
    [[ "$sname" == "$target" || "$sname" == *" $target" ]] && return 0
  done <<< "$open_names"
  return 1
}

# 2. Collect zoxide directories, minus any whose tmux session already exists.
# Selecting a dir creates/switches to a session named after its sanitized
# basename (see step 4), so hide dirs that would just duplicate a session.
if command -v zoxide &>/dev/null; then
  dirs=$(zoxide query -l | while IFS= read -r d; do
    b="${d##*/}"; b="${b//[ .]/_}"
    _has_session_for "$b" || printf '%s %s\n' "$dir_icon" "$d"
  done)
else
  dirs=""
fi

# 2b. Collect this repo's worktrees to open, straight from git (instant and
# always fresh, unlike `workmux list` which spends seconds on per-worktree status
# checks). Repo comes from the script's cwd: the C-M-a binding passes the pane's
# dir (see cd above) inside tmux, and the zsh widget runs us in the shell's dir
# outside tmux. handle = the worktree's directory name. Drop the bare repo and
# any worktree that already has a tmux session (shown as a session instead),
# using the same session-match helper. Skipped only from the floating scratchpad
# (workmux would open into the popup).
worktrees=""
if [[ "$current_session" != floating-* ]] &&
  command -v workmux &>/dev/null && command -v git &>/dev/null; then
  worktrees=$(
    git worktree list --porcelain 2>/dev/null | awk '
      /^worktree /{path=$2; bare=0}
      /^bare/{bare=1}
      /^branch /{ if (!bare) { n=split(path, a, "/"); print a[n] } }
    ' | while IFS= read -r handle; do
      _has_session_for "$handle" || printf '%s %s\n' "$worktree_icon" "$handle"
    done
  )
fi

# 3. Combine and select using fzf-tmux popup. Order: sessions, then worktrees,
# then the long zoxide list.
choice=$(printf '%s\n%s\n%s' "$sessions" "$worktrees" "$dirs" | grep . | fzf-tmux -p 70%,70% --reverse)

[[ -z "$choice" ]] && exit 0

# 4. Determine target
icon="${choice%% *}"
value="${choice#* }"

if [[ "$icon" == "$worktree_icon" ]]; then
  # A workmux worktree handle. `-s` forces session mode, overriding whatever mode
  # workmux has frozen per-worktree in its state (e.g. an old worktree created
  # before `mode: session` stays stored as window and then fails the `windows:`
  # requirement). workmux resolves the worktree from cwd and switches to its
  # session itself. Inside tmux, hand straight to it. Outside tmux, workmux needs
  # the tmux backend, so enter tmux via a throwaway session that runs the open;
  # workmux switches this client into the worktree's session and the throwaway
  # session ends when the open returns.
  # >/dev/null drops workmux's success banner so we land straight in the session
  # (tmux otherwise shows it in a dismiss-me pager); stderr stays for real errors.
  if [[ -n "$TMUX" ]]; then
    exec workmux open -s "$value" >/dev/null
  else
    exec tmux new-session -s "wmboot-$$" -c "$PWD" "workmux open -s '$value' >/dev/null"
  fi
fi

if [[ "$icon" == "$session_icon" ]]; then
  # It's an existing session
  target="$value"
else
  # It's a directory: create session if needed
  target_path="$value"
  # Sanitize: use basename and replace characters that might annoy tmux
  target=$(basename "$target_path" | tr ' .' '__')

  if ! tmux has-session -t "$target" 2>/dev/null; then
    layout_file=""
    named_file=""
    for candidate in "$target_path/.tmuxinator.yml" "$target_path/.tmuxinator.yaml"; do
      if [[ -f "$candidate" ]]; then
        layout_file="$candidate"
        break
      fi
    done
    for candidate in "$HOME/.config/tmuxinator/${target}.yml" "$HOME/.config/tmuxinator/${target}.yaml"; do
      if [[ -f "$candidate" ]]; then
        named_file="$candidate"
        break
      fi
    done

    started=0
    if command -v tmuxinator &>/dev/null; then
      tmuxinator_flags=(--no-attach --suppress-tmux-version-warning --name "$target")
      if [[ -n "$layout_file" ]]; then
        tmuxinator start --project-config "$layout_file" "${tmuxinator_flags[@]}" && started=1
      elif [[ -n "$named_file" ]]; then
        tmuxinator start "$target" "${tmuxinator_flags[@]}" && started=1
      fi
    fi

    if [[ "$started" -eq 0 ]] && ! tmux has-session -t "$target" 2>/dev/null; then
      tmux new-session -ds "$target" -c "$target_path"
    fi
  fi
fi

# 5. Hand off to the popup-aware switcher (attaches when outside tmux, moves the
# outer client and closes the popup when run from inside a floating scratchpad).
"$HOME/.local/bin/tmux-goto" "$target"
