#!/usr/bin/env bash
# Command palette: fuzzy-find a command in the registry, type its arguments,
# and run it. Opened from kitty's overlay (kitty.conf's ctrl+cmd+p, ctrl+alt+p
# on Linux), so it works the same inside tmux or outside it. Like
# kitty-tmux-attach, it runs without a login shell's environment, so it sets
# PATH (brew) and fzf's theme itself.
#
# A command is a zsh function or alias: it runs in `zsh -ic`, which loads
# .zshrc where start-dotfiles-change and the rest are defined. The text typed
# after it is passed as its arguments, as shell words, just as on a command
# line.
#
# The registry is one `name<TAB>description` line per command; '#' comments and
# blank lines are skipped. COMMAND_PALETTE_COMMANDS points at another file.

. "$HOME/.local/lib/brew-prefix.sh"
export PATH="$HOME/.local/bin:$BREW_PREFIX/bin:$PATH"
. "${XDG_CONFIG_HOME:-$HOME/.config}/fzf/theme.sh"

palette_commands_file=${COMMAND_PALETTE_COMMANDS:-${XDG_CONFIG_HOME:-$HOME/.config}/command-palette/commands}

# The registry's commands, one per line, as the picker shows them.
palette_list() {
  grep -vE '^[[:space:]]*(#|$)' "$palette_commands_file"
}

# Runs one command with its arguments. TMUX is unset: with it set, tmux-goto
# would switch the most recently used client, which can be another kitty tab
# (see kitty-tmux-attach). Unset here, a session it attaches to is attached.
palette_run() {
  unset TMUX
  zsh -ic "$1 $2"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  if [[ ! -r $palette_commands_file ]]; then
    echo "command-palette: no registry at $palette_commands_file" >&2
    read -r -p "press enter to close " _
    exit 1
  fi

  # Esc or Ctrl-C in the picker closes the palette.
  choice=$(palette_list | fzf --prompt='command> ' --header='enter: pick, then type its arguments') || exit 0
  name=${choice%%$'\t'*}

  # The arguments are edited with zsh's vared, not bash's readline: `read -e`
  # inside zsh -ic did not take ctrl+arrows. vared draws to stdout, so the typed
  # line goes to a temp file instead of being captured. On Esc or Ctrl-C vared
  # fails, nothing is written, and the palette closes without running.
  argsfile=$(mktemp) || exit 1
  trap 'rm -f "$argsfile"' EXIT
  zsh -ic 'typeset args=; vared -p "$1 " args && print -r -- "$args" >|"$2"' _ "$name" "$argsfile" || exit 0
  args=$(cat "$argsfile")
  palette_run "$name" "$args"
  status=$?

  # A failing command leaves its message on screen until a key closes the overlay.
  if ((status != 0)); then
    printf '\n%s exited %d; press enter to close ' "$name" "$status"
    read -r _
  fi
  exit "$status"
fi
