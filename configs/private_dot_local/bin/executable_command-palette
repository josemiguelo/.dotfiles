#!/usr/bin/env bash
# Command palette: fuzzy-find a command in the registry, type its arguments,
# and run it. Opened from kitty's overlay (kitty.conf's ctrl+cmd+p, ctrl+alt+p
# on Linux), so it works the same inside tmux or outside it. Like
# kitty-tmux-attach, it runs without a login shell's environment, so it sets
# PATH (brew) and fzf's theme itself.
#
# A command is a zsh function or alias: it runs in `zsh -ic`, which loads
# .zshrc where start-dotfiles-change and the rest are defined. The text typed
# after it is passed as its arguments, as shell words, just as on a command
# line.
#
# The registry is one `name<TAB>description` line per command; '#' comments and
# blank lines are skipped. An optional third field, `<TAB>command`, is what runs
# instead of the name (which is then just a label); the picker doesn't show it.
# COMMAND_PALETTE_COMMANDS points at another file.

# macOS: a login shell starts from path_helper's PATH (/etc/paths and paths.d,
# e.g. /usr/local/bin, where Docker Desktop links docker). kitty's overlay gets
# only launchd's bare PATH and the `zsh -ic` below is not a login shell, so
# without this the command would not find docker and the like.
if [[ -x /usr/libexec/path_helper ]]; then
  eval "$(/usr/libexec/path_helper -s)"
fi

. "$HOME/.local/lib/brew-prefix.sh"
export PATH="$HOME/.local/bin:$BREW_PREFIX/bin:$PATH"
. "${XDG_CONFIG_HOME:-$HOME/.config}/fzf/theme.sh"

palette_commands_file=${COMMAND_PALETTE_COMMANDS:-${XDG_CONFIG_HOME:-$HOME/.config}/command-palette/commands}

# The registry's commands as the picker shows them: a table, the names padded to
# the longest so the descriptions line up, each column in its own color (the
# terminal's blue and green, so they follow its theme). A line is the display
# text, then the name and the command line (empty when the line has none), by
# tabs: the picker shows the first field only, and what it returns says what was
# picked without parsing the display text.
palette_list() {
  grep -vE '^[[:space:]]*(#|$)' "$palette_commands_file" | awk -F'\t' '
    { name[NR] = $1; desc[NR] = $2; cmd[NR] = $3; if (length($1) > width) width = length($1) }
    END {
      for (i = 1; i <= NR; i++) {
        pad = sprintf("%" width "s", "")
        shown = name[i] substr(pad, 1, width - length(name[i]))
        printf "\033[1;34m%s\033[0m  \033[32m%s\033[0m\t%s\t%s\n", shown, desc[i], name[i], cmd[i]
      }
    }'
}

# Runs one command line with its arguments. TMUX is unset: with it set, tmux-goto
# would switch the most recently used client, which can be another kitty tab
# (see kitty-tmux-attach). Unset here, a session it attaches to is attached.
palette_run() {
  unset TMUX
  zsh -ic "$1 $2"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  if [[ ! -r $palette_commands_file ]]; then
    echo "command-palette: no registry at $palette_commands_file" >&2
    read -r -p "press enter to close " _
    exit 1
  fi

  # Esc or Ctrl-C in the picker closes the palette.
  choice=$(palette_list | fzf --ansi --delimiter=$'\t' --with-nth=1 --prompt='command> ' --header='enter: pick') || exit 0
  IFS=$'\t' read -r _ name command_line <<<"$choice"
  # The command line is the registry's third field when the line has one, else the name.
  command_line=${command_line:-$name}

  # Yes/No question, as gum's confirm. Ctrl-C closes the palette (130); Esc is
  # gum's 'No', so it runs the command with no arguments.
  args=
  gum confirm 'Enter arguments for this command?'
  case $? in
  0)
    # The arguments are edited with zsh's vared, not bash's readline: `read -e`
    # inside zsh -ic did not take ctrl+arrows. vared draws to stdout, so the
    # typed line goes to a temp file instead of being captured. On Esc or Ctrl-C
    # vared fails, nothing is written, and the palette closes without running.
    argsfile=$(mktemp) || exit 1
    trap 'rm -f "$argsfile"' EXIT
    zsh -ic 'typeset args=; vared -p "$1 " args && print -r -- "$args" >|"$2"' _ "$name" "$argsfile" || exit 0
    args=$(cat "$argsfile")
    ;;
  1) ;;
  *) exit 0 ;;
  esac
  palette_run "$command_line" "$args"
  status=$?

  # A failing command leaves its message on screen until a key closes the overlay.
  if ((status != 0)); then
    printf '\n%s exited %d; press enter to close ' "$name" "$status"
    read -r _
  fi
  exit "$status"
fi
