#!/usr/bin/env bash
# Runs tmux-attach in a kitty overlay (see kitty.conf's ctrl+cmd+a). Like
# kitty-workmux-dashboard, it gets PATH from Homebrew (brew-prefix.sh):
# kitty's launch environment doesn't have it. The overlay isn't a tmux client,
# so without TMUX set, tmux-goto would attach a second client inside the
# overlay. Setting TMUX makes tmux-goto switch the most recently used client
# instead, but only when one is attached: with none (the usual case when you're
# outside tmux), switch-client fails with "no current client" and the overlay
# closes at once. So TMUX is set only with a client to switch, and otherwise
# tmux-goto attaches the overlay. TMUX_ATTACH_INLINE is always set: it asks
# tmux-attach for a plain fzf that draws here, not fzf-tmux's popup. The
# listing starts from the client's pane directory, as the tmux binding does,
# and falls back to the overlay's own directory with no server.
. "$HOME/.local/lib/brew-prefix.sh"
export PATH="$BREW_PREFIX/bin:$PATH"
export TMUX_ATTACH_INLINE=1

socket=$(tmux display-message -p '#{socket_path}' 2>/dev/null)
if [[ -n "$socket" ]]; then
  path=$(tmux display-message -p '#{pane_current_path}' 2>/dev/null)
  [[ -n "$(tmux list-clients 2>/dev/null)" ]] && export TMUX="$socket,$$,0"
fi

exec "$HOME/.local/bin/tmux-attach" "${path:-$PWD}"
