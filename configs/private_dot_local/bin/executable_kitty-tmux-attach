#!/usr/bin/env bash
# Runs tmux-attach in a kitty overlay (see kitty.conf's ctrl+cmd+a). Like
# workmux-dashboard, it puts ~/.local/bin and Homebrew on PATH, as a login
# shell would: kitty's launch environment has neither. The overlay always attaches
# itself: TMUX stays unset, so tmux-goto runs a plain attach-session here.
# Setting TMUX would make tmux-goto switch the most recently used client, which
# can be another kitty tab. Inside tmux, prefix + A is the picker that switches
# the client you're using. The listing starts from the client's pane directory,
# as the tmux binding does, and falls back to the overlay's own directory with
# no server.
. "$HOME/.local/lib/brew-prefix.sh"
export PATH="$HOME/.local/bin:$BREW_PREFIX/bin:$PATH"

socket=$(tmux display-message -p '#{socket_path}' 2>/dev/null)
if [[ -n "$socket" ]]; then
  path=$(tmux display-message -p '#{pane_current_path}' 2>/dev/null)
fi

# TMUX_ATTACH_INLINE asks tmux-attach for a plain fzf that draws here, not
# fzf-tmux's popup. Set on the exec only, never exported: a tmux server started
# by the calls above would inherit it, and every popup it opens would then draw
# plain fzf.
exec env TMUX_ATTACH_INLINE=1 "$HOME/.local/bin/tmux-attach" "${path:-$PWD}"
