{{- /*
  JSON of .over on top of .under: tables merge key by key, anything else
  (lists too) replaces, as loadout merges data. Not sprig's mergeOverwrite:
  it skips zero values, so a machine's `false` could never override a base's
  `true`.
*/ -}}
{{- $out := dict -}}
{{- range $key, $value := .under }}{{ $_ := set $out $key $value }}{{ end -}}
{{- range $key, $value := .over -}}
{{-   $under := get $out $key -}}
{{-   if and (kindIs "map" $under) (kindIs "map" $value) -}}
{{-     $_ := set $out $key (includeTemplate "merge-data" (dict "under" $under "over" $value) | fromJson) -}}
{{-   else -}}
{{-     $_ := set $out $key $value -}}
{{-   end -}}
{{- end -}}
{{- $out | toJson -}}
