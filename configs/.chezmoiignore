.config/zsh/.zplugins.zsh.zwc
.config/zsh/.zplugins.zsh.zwc.old
.config/zsh/.zcompdump

# The nvim config's README and license stay in the source, out of $HOME.
.config/nvim/README.md
.config/nvim/LICENSE

# The agents Omarchy installs through mise: Omarchy machines only. The whole
# directory, or chezmoi still creates it (empty) around the ignored file.
{{ if not (includeTemplate "loadout/machine" . | fromJson).omarchy }}
.config/mise/conf.d
.config/mise/conf.d/**
{{ end }}

# fcitx5 is Omarchy's input method: its settings are for Omarchy machines only.
{{ if not (includeTemplate "loadout/machine" . | fromJson).omarchy }}
.config/fcitx5
.config/fcitx5/**
{{ end }}

# Switching between the machine's dark and light Omarchy theme.
{{ if not (includeTemplate "loadout/machine" . | fromJson).omarchy }}
.local/bin/omarchy-theme-mode-toggle
{{ end }}

# Spotify's launch flags work around a crash under Omarchy's Wayland session.
{{ if not (includeTemplate "loadout/machine" . | fromJson).omarchy }}
.config/spotify-flags.conf
{{ end }}

# omalauncher's Arch gets only its own: the launcher's configs, its zsh
# (zsh-omalauncher, which ~/.zshenv points at there), its mise tools
# (conf.d/omalauncher.toml, not config.toml's languages) and the agents'
# global instructions pointing at this repo. The desktops' configs (zsh,
# nvim, kitty, ...) are for desktops, and theirs stay out of it.
{{ if (includeTemplate "loadout/machine" . | fromJson).omalauncher }}
*
.*
!.zshenv
!.claude
!.claude/CLAUDE.md
!.codex
!.codex/AGENTS.md
!.config
.config/*
!.config/omalauncher
!.config/omalauncher/**
!.config/zsh-omalauncher
!.config/zsh-omalauncher/**
!.config/mise
.config/mise/*
!.config/mise/conf.d
.config/mise/conf.d/*
!.config/mise/conf.d/omalauncher.toml
!.local
.local/*
!.local/share
.local/share/*
!.local/share/workflow-skills
!.local/share/workflow-skills/**
!.local/bin
.local/bin/*
!.local/bin/dotfiles-worktree-check
{{ else }}
.config/omalauncher
.config/omalauncher/**
.config/zsh-omalauncher
.config/zsh-omalauncher/**
.config/mise/conf.d/omalauncher.toml
.claude
.claude/**
.codex
.codex/**
{{ end }}
