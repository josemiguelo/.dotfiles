face "sysmon" {
  // A system monitor for the Arch side, left of page 1, in the Omarchy way: a bar with workspaces over tiled windows.
  // 1 desk (everything at a glance), 2 cpu, 3 memory, 4 processes, 5 system.
  meta { owl: 13; description: "A system monitor in workspaces: an overview, CPU over time and per core, memory and disk, every busy process, and the system"; version: "2.0"; license: "MIT"; category: "system" }
  page: 0
  statusBar: false
  padding: 0

  requires { pacman: ["procps-ng", "gawk", "coreutils", "btop"] }

  source now = clock every 1m
  source bat = android.battery
  source dev = android.device
  source sys = android.system every 10m
  // One JSON line: cpu use over a second, memory, cache, swap, disk, per-core frequencies and uptime.
  source s = cmd("""
    a=$(grep '^cpu ' /proc/stat); sleep 1; b=$(grep '^cpu ' /proc/stat)
    printf '%s\n%s\n' "$a" "$b" | awk '{busy[NR]=$2+$3+$4+$7+$8; all[NR]=busy[NR]+$5+$6} END{d=all[2]-all[1]; printf "{\"cpu\":%.1f,", (d>0 ? (busy[2]-busy[1])*100/d : 0)}'
    free -b | awk '/Mem:/{printf "\"mt\":%s,\"mu\":%s,\"cache\":%s,\"ma\":%s,",$2,$3,$6,$7} /Swap:/{printf "\"st\":%s,\"su\":%s,",$2,$3}'
    df -B1 / | awk 'NR==2{printf "\"dt\":%s,\"du\":%s,",$2,$3}'
    printf '"freq":[%s],"fmax":[%s],"fmin":[%s],' "$(cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq | paste -sd,)" "$(cat /sys/devices/system/cpu/cpu*/cpufreq/cpuinfo_max_freq | paste -sd,)" "$(cat /sys/devices/system/cpu/cpu*/cpufreq/cpuinfo_min_freq | paste -sd,)"
    awk '{printf "\"up\":%d}\n",$1}' /proc/uptime
  """) every 3s json
  // The busiest processes, by cpu or by memory as the processes workspace sorts them; ps itself and the face's own helpers left out.
  source top = cmd("ps -eo pid=,pcpu=,rss=,etimes=,comm= --sort=${sh(sortBy == "mem" ? "-rss" : "-pcpu")} | grep -vE ' (ps|awk|grep|head|sleep)$' | head -40") every 5s
  // The biggest by memory, for the memory workspace whatever the processes one sorts by.
  source topMem = cmd("ps -eo pid=,pcpu=,rss=,etimes=,comm= --sort=-rss | grep -vE ' (ps|awk|grep|head|sleep)$' | head -15") every 10s
  source info = cmd("""
    . /etc/os-release
    printf '%s\t%s\t%s\t%s' "$(uname -r | cut -d- -f1)" "$(pacman -Qq | wc -l)" "$PRETTY_NAME" "$(basename "$SHELL")"
  """) every 1h

  state ws = 1
  state sortBy = "cpu" persist

  let cpu = s.cpu == null ? null : clamp(s.cpu, 0, 100)
  let cpuHist = history(cpu, 60) persist
  let cpuLong = history(cpu, 200) persist
  let mem = s.mt ? (s.mt - s.ma) / s.mt * 100 : null
  let memLong = history(mem, 200) persist
  let swap = s.st ? s.su / s.st * 100 : 0
  let disk = s.dt ? s.du / s.dt * 100 : null
  let cores = range(len(s.freq ?? [])).map(i => { f: num(s.freq[i]) / 1000, m: num(s.fmax[i]) / 1000, lo: num(s.fmin[i]) / 1000 })
  let procs = lines(top ?? "").map(l => { pid: num(words(l)[0]), cpu: num(words(l)[1]), mem: num(words(l)[2]) * 1024, age: num(words(l)[3]), name: words(l)[4] })
  let memProcs = lines(topMem ?? "").map(l => { pid: num(words(l)[0]), cpu: num(words(l)[1]), mem: num(words(l)[2]) * 1024, age: num(words(l)[3]), name: words(l)[4] })
  let parts = split(info ?? "", "\t")
  let kernel = parts[0]
  let pkgs = parts[1]
  let osName = parts[2]
  let shellName = parts[3]
  let host = lower(replace(trim(dev.model ?? "phone"), " ", "-"))
  let wide = (tileWidth ?? 0) > (tileHeight ?? 1)
  let names = ["desk", "cpu", "mem", "procs", "sys"]
  let glass = alpha(background, tileOpacity)
  let gap = gapsIn + 4

  background: linear(0, 0, 0, 1, [alpha(background, 0.8), alpha(background, 0.55), alpha(background, 0.85)])

  // A workspace's number in the bar, underlined while it shows.
  component Ws(n) {
    Column {
      gap: 2
      align: center
      width: 24
      onTap: { ws = n; haptic() }
      Text { text: "${n}"; font: mono; fontSize: 14; fontWeight: ws == n ? 700 : 500; color: ws == n ? accent : alpha(foreground, 0.55); align: center; width: 24 }
      Box { width: 14; height: 2; background: ws == n ? accent : alpha(foreground, 0) }
    }
  }

  // A window's title, as Omarchy's are.
  component Title(label, note = "") {
    Row {
      align: center
      Text { text: label; font: mono; style: label; color: accent; weight: 1 }
      Text { text: note; font: mono; style: label; color: muted; maxLines: 1 }
    }
  }

  component Meter(label, value, detail, tint = accent) {
    Column {
      gap: 4
      Row {
        align: center
        Text { text: label; font: mono; style: small; color: muted; weight: 1 }
        Text { text: detail; font: mono; style: small; maxLines: 1 }
      }
      Progress { value: value; color: value > 90 ? red : value > 75 ? yellow : tint; track: alpha(foreground, 0.12); height: 6; fill: width; animate value: spring() }
    }
  }

  component Line(key, value) {
    Row {
      gap: 12
      Text { text: key; font: mono; fontSize: 14; color: accent; width: 76; maxLines: 1 }
      Text { text: value; font: mono; fontSize: 14; maxLines: 1; weight: 1 }
    }
  }

  // Each core's clock against its maximum, its speed in GHz under it.
  component CoreBars(barHeight) {
    Canvas {
      height: barHeight + 16
      fill: width
      let n = max(len(cores), 1)
      let g = 6
      let bw = (width - g * (n - 1)) / n
      let bh = height - 16
      for c, i in cores {
        let t = c.m ? clamp(c.f / c.m, 0, 1) : 0
        rect(i * (bw + g), 0, bw, bh, radius: 3 * corners, fill: alpha(foreground, 0.08))
        rect(i * (bw + g), bh - bh * t, bw, bh * t, radius: 3 * corners, fill: t > 0.85 ? orange : t > 0.5 ? accent : alpha(accent, 0.6))
        text(fixed(c.f / 1000, 1), i * (bw + g) + bw / 2, height - 2, size: 9, align: center, color: muted)
      }
    }
  }

  component ProcRow(p, detail) {
    Row {
      align: center
      gap: 10
      padding: [0, 3]
      onTap: terminal("top -p ${int(p.pid)}", p.name)
      Text { text: p.name; font: mono; style: small; maxLines: 1; weight: 1 }
      if detail {
        Text { text: "${int(p.pid)}"; font: mono; style: small; color: muted; width: 52; align: end }
        Text { text: fmtDuration(p.age); font: mono; style: small; color: muted; width: 60; align: end; maxLines: 1 }
      }
      Text { text: "${fixed(p.cpu, 1)}%"; font: mono; style: small; color: p.cpu > 50 ? orange : sortBy == "cpu" ? foreground : muted; width: 52; align: end }
      Text { text: fmtBytes(p.mem); font: mono; style: small; color: sortBy == "mem" ? foreground : muted; width: 52; align: end }
    }
  }

  // ── windows on the desk: each opens its workspace ──

  component CpuWin() {
    Column {
      gap: 10
      padding: 14
      background: glass
      frost: tileFrost
      border: borderWidth
      borderColor: border
      onTap: ws = 2
      Title { label: "cpu"; note: "${len(cores)} cores" }
      Row {
        align: center
        gap: 12
        Text { text: cpu == null ? "…" : "${round(cpu)}%"; font: mono; fontSize: 40; fontWeight: 300; color: cpu > 85 ? red : foreground; width: 104 }
        Sparkline { values: cpuHist; min: 0; max: 100; color: accent; area: true; thickness: 1.5; height: 56; weight: 1 }
      }
      CoreBars { barHeight: 48 }
    }
  }

  component MemWin() {
    Column {
      gap: 10
      padding: 14
      background: glass
      frost: tileFrost
      border: borderWidth
      borderColor: border
      onTap: ws = 3
      Title { label: "memory"; note: "${fmtBytes(s.mt)}" }
      Row {
        align: center
        gap: 14
        Box {
          size: 72
          align: center
          Ring { value: mem ?? 0; max: 100; color: mem > 85 ? red : green; track: alpha(foreground, 0.12); thickness: 7; start: 225; sweep: 270; fill: true }
          Text { text: mem == null ? "…" : "${round(mem)}%"; font: mono; style: body; align: center }
        }
        Column {
          gap: 8
          weight: 1
          Meter { label: "ram"; value: mem ?? 0; detail: "${fmtBytes(s.mt - s.ma)} / ${fmtBytes(s.mt)}"; tint: green }
          Meter { label: "swap"; value: swap; detail: "${fmtBytes(s.su)} / ${fmtBytes(s.st)}"; tint: magenta }
          Meter { label: "disk /"; value: disk ?? 0; detail: "${fmtBytes(s.du)} / ${fmtBytes(s.dt)}"; tint: blue }
        }
      }
    }
  }

  component ProcsWin() {
    Column {
      gap: 6
      padding: 14
      background: glass
      frost: tileFrost
      border: borderWidth
      borderColor: border
      clip: true
      onTap: ws = 4
      Title { label: "processes"; note: sortBy == "mem" ? "cpu      mem ▾" : "cpu ▾      mem" }
      for p in procs.take(14) key p.pid {
        ProcRow { p: p; detail: false }
      }
    }
  }

  // ── workspaces ──

  // 2: cpu over the last ten minutes, and every core.
  component CpuWs() {
    Column {
      fill: true
      gap: 12
      padding: 14
      background: glass
      frost: tileFrost
      border: borderWidth
      borderColor: accent
      Title { label: "cpu"; note: "last 10m" }
      Row {
        align: bottom
        gap: 12
        Text { text: cpu == null ? "…" : "${round(cpu)}%"; font: mono; fontSize: 56; fontWeight: 300; color: cpu > 85 ? red : foreground }
        Column {
          gap: 0
          weight: 1
          Text { text: "avg ${round(avg(cpuLong) ?? 0)}%"; font: mono; style: small; align: end }
          Text { text: "peak ${round(max(cpuLong) ?? 0)}%"; font: mono; style: small; color: muted; align: end }
        }
      }
      Sparkline { values: cpuLong; min: 0; max: 100; color: accent; area: true; thickness: 1.5; weight: 1; fill: width }
      Title { label: "cores"; note: "GHz now" }
      CoreBars { barHeight: 96 }
      Column {
        gap: 2
        for c, i in cores {
          Row {
            gap: 10
            Text { text: "cpu${i}"; font: mono; style: small; color: muted; width: 44 }
            Text { text: "${round(c.f)} MHz"; font: mono; style: small; weight: 1 }
            Text { text: "${round(c.lo)}–${round(c.m)}"; font: mono; style: small; color: muted }
          }
        }
      }
    }
  }

  // 3: where the memory goes, and who holds it.
  component MemWs() {
    Column {
      fill: true
      gap: 12
      padding: 14
      background: glass
      frost: tileFrost
      border: borderWidth
      borderColor: accent
      Title { label: "memory"; note: "last 10m" }
      Row {
        align: bottom
        gap: 12
        Text { text: mem == null ? "…" : "${round(mem)}%"; font: mono; fontSize: 56; fontWeight: 300; color: mem > 85 ? red : foreground }
        Column {
          gap: 0
          weight: 1
          Text { text: "${fmtBytes(s.ma)} free"; font: mono; style: small; align: end }
          Text { text: "of ${fmtBytes(s.mt)}"; font: mono; style: small; color: muted; align: end }
        }
      }
      Sparkline { values: memLong; min: 0; max: 100; color: green; area: true; thickness: 1.5; height: 72; fill: width }
      // Used, cache and free as one bar.
      Canvas {
        height: 14
        fill: width
        let u = s.mt ? s.mu / s.mt : 0
        let c = s.mt ? s.cache / s.mt : 0
        rect(0, 0, width, height, radius: 4 * corners, fill: alpha(foreground, 0.1))
        rect(width * u, 0, width * c, height, fill: alpha(yellow, 0.7))
        rect(0, 0, width * u, height, radius: 4 * corners, fill: green)
      }
      Row {
        gap: 14
        Text { spans: [{text: "■ ", color: green}, "used ${fmtBytes(s.mu)}"]; font: mono; style: small }
        Text { spans: [{text: "■ ", color: yellow}, "cache ${fmtBytes(s.cache)}"]; font: mono; style: small }
      }
      Meter { label: "swap"; value: swap; detail: "${fmtBytes(s.su)} / ${fmtBytes(s.st)}"; tint: magenta }
      Meter { label: "disk /"; value: disk ?? 0; detail: "${fmtBytes(s.du)} / ${fmtBytes(s.dt)}"; tint: blue }
      Title { label: "by memory"; note: "" }
      Column {
        gap: 0
        weight: 1
        clip: true
        for p in memProcs key p.pid {
          ProcRow { p: p; detail: false }
        }
      }
    }
  }

  // 4: the forty busiest; tap a column's name to sort by it, a row to watch it in top.
  component ProcsWs() {
    Column {
      fill: true
      gap: 8
      padding: 14
      background: glass
      frost: tileFrost
      border: borderWidth
      borderColor: accent
      Row {
        align: center
        gap: 10
        Text { text: "processes"; font: mono; style: label; color: accent; weight: 1 }
        Text { text: "pid"; font: mono; style: label; color: muted; width: 52; align: end }
        Text { text: "up"; font: mono; style: label; color: muted; width: 60; align: end }
        Text { text: sortBy == "cpu" ? "cpu ▾" : "cpu"; font: mono; style: label; color: sortBy == "cpu" ? accent : muted; width: 52; align: end; onTap: sortBy = "cpu" }
        Text { text: sortBy == "mem" ? "mem ▾" : "mem"; font: mono; style: label; color: sortBy == "mem" ? accent : muted; width: 52; align: end; onTap: sortBy = "mem" }
      }
      Column {
        scroll: true
        weight: 1
        gap: 0
        for p in procs key p.pid {
          ProcRow { p: p; detail: true }
        }
      }
      Text { text: "tap a process to watch it in top"; font: mono; style: label; color: muted; align: center }
    }
  }

  // 5: the system, fastfetch style, and the tools.
  component SysWs() {
    Column {
      fill: true
      gap: 12
      padding: 14
      background: glass
      frost: tileFrost
      border: borderWidth
      borderColor: accent
      Text { text: "arch"; font: mono; fontSize: 26; fontWeight: 700; letterSpacing: 1 }
      Text { spans: [{text: "root", color: accent, bold: true}, "@", {text: host, color: accent, bold: true}]; font: mono; fontSize: 16; maxLines: 1 }
      Column {
        gap: 3
        for row in [[color0, color1, color2, color3, color4, color5, color6, color7], [color8, color9, color10, color11, color12, color13, color14, color15]] {
          Row {
            gap: 3
            for c in row { Box { width: 16; height: 8; background: c } }
          }
        }
      }
      Column {
        gap: 3
        Line { key: "os"; value: osName }
        Line { key: "host"; value: dev == null ? null : "${dev.maker} ${dev.model}" }
        Line { key: "android"; value: dev.android }
        Line { key: "kernel"; value: kernel }
        Line { key: "uptime"; value: fmtDuration(s.up) }
        Line { key: "pkgs"; value: pkgs == null ? null : "${pkgs} (pacman)" }
        Line { key: "shell"; value: shellName }
        Line { key: "wm"; value: sys.launcher == null ? null : "omalauncher ${sys.launcher}" }
        Line { key: "theme"; value: lower(sys.theme ?? "default") }
        Line { key: "cpu"; value: sys.cpu == null ? null : "${sys.cpu.soc ?? sys.cpu.hardware} (${len(cores)})" }
        Line { key: "memory"; value: "${fmtBytes(s.mt - s.ma)} / ${fmtBytes(s.mt)}" }
        Line { key: "disk"; value: "${fmtBytes(s.du)} / ${fmtBytes(s.dt)}" }
        Line { key: "battery"; value: "${bat.level}%${bat.charging ? " · charging" : ""}" }
      }
      Spacer { weight: 1 }
      Row {
        gap: 8
        Box {
          weight: 1
          onTap: terminal("btop", "btop")
          Text { text: "btop"; font: mono; style: small; align: center; fill: width; padding: [0, 10]; border: 1; borderColor: alpha(accent, 0.5); radius: 6 * corners }
        }
        Box {
          weight: 1
          onTap: terminal("sudo pacman -Syu; exec bash", "update")
          Text { text: "update"; font: mono; style: small; align: center; fill: width; padding: [0, 10]; border: 1; borderColor: alpha(muted, 0.4); radius: 6 * corners }
        }
        Box {
          weight: 1
          onTap: terminal("bash", "shell")
          Text { text: "shell"; font: mono; style: small; align: center; fill: width; padding: [0, 10]; border: 1; borderColor: alpha(muted, 0.4); radius: 6 * corners }
        }
      }
    }
  }

  Column {
    fill: true
    gap: 0

    // The bar: workspaces, the time, the battery. The dot opens the style screen, as Omarchy's mark opens its menu.
    Row {
      align: center
      padding: [10, 6]
      background: background
      Row {
        width: 140
        gap: 0
        align: center
        Text { text: "●"; fontSize: 10; color: accent; width: 14; align: center; onTap: launcher("style") }
        for n in range(1, 6) {
          Ws { n: n }
        }
      }
      Spacer { weight: 1 }
      Text { text: fmtTime(now, "EEE d  HH:mm"); font: mono; fontSize: 13; maxLines: 1 }
      Spacer { weight: 1 }
      Row {
        width: 140
        gap: 8
        align: center
        justify: end
        Text { text: names[ws - 1]; font: mono; fontSize: 12; color: muted }
        Text {
          text: bat == null ? null : "${bat.charging ? "⚡" : ""}${bat.level}%"
          font: mono
          fontSize: 13
          color: bat.charging ? green : bat.level <= 15 ? red : bat.level <= 30 ? yellow : foreground
        }
      }
    }

    Column {
      weight: 1
      fill: width
      gap: gap
      padding: [12, 10]
      if ws == 1 {
        // 1: everything at a glance; a window opens its workspace.
        if wide {
          Row {
            fill: true
            gap: gap
            Column { weight: 1; fill: height; gap: gap; CpuWin { }; MemWin { } }
            ProcsWin { weight: 1; fill: height }
          }
        } else {
          CpuWin { }
          MemWin { }
          ProcsWin { weight: 1; fill: true }
        }
      } else if ws == 2 {
        CpuWs { fill: true }
      } else if ws == 3 {
        MemWs { fill: true }
      } else if ws == 4 {
        ProcsWs { fill: true }
      } else {
        SysWs { fill: true }
      }
    }

    Spacer { height: screenInset }
  }
}
