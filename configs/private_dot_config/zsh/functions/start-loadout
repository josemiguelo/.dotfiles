#!/bin/zsh
# start-loadout [-p prompt] [query]: a try folder whose claude works on the
# loadout repos. Copies in, from ~/.local/share/workflow-skills (rendered per
# machine by chezmoi), NEW-LOADOUT-SESSION-AGENTS.md as AGENTS.md (Claude
# Code reads it at every start there, so it applies from the first message)
# and NEW-LOADOUT-SESSION-SETTINGS.json as .claude/settings.local.json (read
# and edit access to those repos, granted before claude starts: a session
# can't grant itself permissions). Then opens a tmux session named after the
# folder with one window, `agent`, running a new claude. Copies, not links: a
# try folder is self-contained. Run again on the same folder, it goes back to
# its session. -p is claude's first message; for a session already open,
# it's pasted into the agent window, only while claude is what runs there.
#
# The helpers below are defined on each call (zfunctions autoloads this
# file's own name only); the _start_loadout_ prefix keeps them out of the way.

# AGENTS.md and the session's settings in the current folder. What's
# already there is left as it is.
_start_loadout_prepare() {
  local src=$HOME/.local/share/workflow-skills
  local f
  for f in NEW-LOADOUT-SESSION-AGENTS.md NEW-LOADOUT-SESSION-SETTINGS.json; do
    if [[ ! -f $src/$f ]]; then
      print -u2 "start-loadout: $src/$f not found -- run chezmoi apply (or loadout apply .local)"
      return 1
    fi
  done
  mkdir -p .claude
  [[ -e AGENTS.md ]] || cp $src/NEW-LOADOUT-SESSION-AGENTS.md AGENTS.md
  [[ -e .claude/settings.local.json ]] || cp $src/NEW-LOADOUT-SESSION-SETTINGS.json .claude/settings.local.json
}

# Prints the session name for the current folder: its name without try's
# date (tmux names can't hold '.' or ':'). A session of that name from
# another folder (the same name, another day) keeps the date on this one.
_start_loadout_name() {
  local dated=${${PWD:t}//[.:]/-}
  local name=${dated#[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-}
  [[ -n $name ]] || name=$dated
  if tmux has-session -t "=$name" 2>/dev/null &&
    [[ $(tmux display-message -p -t "=${name}:" '#{session_path}') != $PWD ]]; then
    name=$dated
  fi
  print -r -- $name
}

# _start_loadout_open <name> [prompt]: the session, its one window running
# claude in the current folder.
_start_loadout_open() {
  local name=$1 prompt=$2 agent=claude
  # A server started here would keep this folder as its own cwd; start it
  # from $HOME, as tmux-workmux-open does.
  tmux list-sessions >/dev/null 2>&1 || (cd ~ && tmux new-session -d -s _bootstrap)
  # The prompt goes through a file: no quoting survives two shells intact.
  if [[ -n $prompt ]]; then
    print -r -- $prompt > .claude/start-prompt.md
    agent='claude "$(cat .claude/start-prompt.md)"'
  fi
  # The window outlives claude: quitting it leaves a shell in the folder.
  tmux new-session -d -s $name -n agent -c $PWD "$agent; exec ${SHELL:-zsh}"
}

# _start_loadout_send <name> <prompt>: pastes the prompt into an open
# session's agent window and submits it. Pasted, not typed: a typed newline
# would submit each line on its own. Into a shell it would run as a command,
# so only while claude runs there — asked of the pane's processes, not
# #{pane_current_command}: the session starts claude from `sh -c`, which has
# no job control, so tmux names the shell. ${name}: zsh reads "$name:a…" as
# the :a (absolute path) modifier.
_start_loadout_send() {
  local name=$1 prompt=$2
  local window="=${name}:agent"
  if pgrep -x -P "$(tmux display-message -p -t $window '#{pane_pid}')" claude >/dev/null; then
    tmux set-buffer -b start-loadout -- $prompt
    tmux paste-buffer -p -d -b start-loadout -t $window
    tmux send-keys -t $window Enter
  else
    print -u2 "start-loadout: claude isn't running in ${name}:agent -- prompt not sent"
  fi
}

# _start_loadout_go <name>: this terminal onto the session, through
# tmux-goto: attach outside tmux, switch inside it, and from a floating
# scratchpad switch the client that opened it and close the popup, so the
# session never lands inside the popup.
_start_loadout_go() {
  tmux-goto "=$1"
}

emulate -L zsh
local -a prompt_opt
zparseopts -D -E -F -- p:=prompt_opt || return
local prompt=${${prompt_opt[-1]}#-p}
try "$@" || return
_start_loadout_prepare || return
local name=$(_start_loadout_name)
if ! tmux has-session -t "=$name" 2>/dev/null; then
  _start_loadout_open $name $prompt
elif [[ -n $prompt ]]; then
  _start_loadout_send $name $prompt
fi
_start_loadout_go $name
