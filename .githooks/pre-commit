#!/bin/sh
# Refuses a commit whose manifests and compiled lock disagree: a pushed
# manifest change without its loadout.lock.json leaves every other machine refusing
# to run until someone compiles. Only commits that touch the manifests or
# what compile writes are checked.
# Enabled per clone with: git config core.hooksPath .githooks
set -eu

root=$(git rev-parse --show-toplevel)

# loadout's bun (the scripts': the one it's built with, `loadout bun`) and
# mise's (the shells') at one version, mise's as it's staged.
mise_config=loadouts/private_dot_config/mise/config.toml
if git diff --cached --name-only | grep -qxE "loadout\.ts|$mise_config"; then
  shells=$(git show ":$mise_config" | sed -nE 's/^[[:space:]]*bun[[:space:]]*=[[:space:]]*"([^"]*)".*/\1/p' | head -n 1)
  scripts=$(loadout bun --version 2>/dev/null) || scripts=
  if [ "$scripts" != "$shells" ]; then
    echo "pre-commit: loadout runs scripts with bun ${scripts:-(unknown: is loadout 5 on PATH?)}, mise's config.toml pins ${shells:-nothing}: move mise's to loadout's" >&2
    exit 1
  fi
fi

generated='loadout.lock.json loadout.sdk.ts loadouts/.chezmoidata/loadout.json loadouts/.chezmoitemplates/loadout'

git diff --cached --name-only | grep -qE '(^|/)loadout\.ts$|\.loadout\.ts$|^machines/data\.ts$|^loadout\.(lock\.json|sdk\.ts)$|^loadouts/\.chezmoi(data|templates)/loadout' || exit 0

command -v loadout >/dev/null 2>&1 || {
  echo "pre-commit: loadout isn't on PATH, so the lock can't be checked" >&2
  exit 1
}
# Any loadout command refuses a lock older than its sources.
if ! out=$(loadout --repo "$root" explain 2>&1); then
  printf 'pre-commit: %s\n' "$(printf '%s\n' "$out" | tail -n 1)" >&2
  exit 1
fi
# shellcheck disable=SC2086 # $generated is a list of paths
if ! (cd "$root" && git diff --quiet -- $generated); then
  echo "pre-commit: what loadout compile wrote isn't staged: git add $generated" >&2
  exit 1
fi
