#!/bin/sh
# Refuses a commit whose manifests and compiled lock disagree: a pushed .hcl
# change without its loadout.lock.json leaves every other machine refusing
# to run until someone compiles. Only commits that touch the manifests or
# what compile writes are checked.
# Enabled per clone with: git config core.hooksPath .githooks
set -eu

root=$(git rev-parse --show-toplevel)

# loadout.hcl's bun (the scripts') and mise's (the shells') at one version,
# as they're staged.
mise_config=loadouts/private_dot_config/mise/config.toml
if git diff --cached --name-only | grep -qxE "loadout\.hcl|$mise_config"; then
  pin() { git show ":$1" | sed -nE "s/^[[:space:]]*bun[[:space:]]*=[[:space:]]*\"([^\"]*)\".*/\1/p" | head -n 1; }
  scripts=$(pin loadout.hcl)
  shells=$(pin "$mise_config")
  if [ "$scripts" != "$shells" ]; then
    echo "pre-commit: loadout.hcl pins bun ${scripts:-nothing}, mise's config.toml ${shells:-nothing}: move both" >&2
    exit 1
  fi
fi

generated='loadout.lock.json loadouts/.chezmoidata/loadout.json loadouts/.chezmoitemplates/loadout'

git diff --cached --name-only | grep -qE '\.hcl$|^loadout\.lock\.json$|^loadouts/\.chezmoi(data|templates)/loadout' || exit 0

command -v loadout >/dev/null 2>&1 || {
  echo "pre-commit: loadout isn't on PATH, so the lock can't be checked" >&2
  exit 1
}
# Any loadout command refuses a lock older than its sources.
if ! out=$(loadout --repo "$root" explain 2>&1); then
  printf 'pre-commit: %s\n' "$(printf '%s\n' "$out" | tail -n 1)" >&2
  exit 1
fi
# shellcheck disable=SC2086 # $generated is a list of paths
if ! (cd "$root" && git diff --quiet -- $generated); then
  echo "pre-commit: what loadout compile wrote isn't staged: git add $generated" >&2
  exit 1
fi
