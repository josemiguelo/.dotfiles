##################
## TMUX OPTIONS ##
##################

# This tells apps inside tmux (like Neovim) that they are in a 256-color tmux session.
set -g default-terminal "tmux-256color"

# This handles True Color (RGB), Undercurls, and Extended Keys for Kitty.
# We use xterm-kitty specifically to ensure Kitty features are mapped correctly.
set -as terminal-features ",xterm-kitty:RGB"
set -as terminal-features ",xterm-kitty:undercurl"
set -as terminal-features ",xterm-kitty:extkeys"
set -as terminal-overrides ",xterm*:Tc" # true color
set -as terminal-overrides ',*:Smulx=\E[4::%p1%dm'
set -as terminal-overrides ',*:Setrgb=\E[48;2;%p1%d;%p2%d;%p3%dm'
set -as terminal-overrides ',xterm*:Ss=\E[%p1%d q:Se=\E[5 q'

# Extended Keys Logic (Keep your existing settings)
set -gs extended-keys on
set -g extended-keys-format csi-u

set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
set-window-option -g automatic-rename off

set -g mouse on
set -g @yank_action 'copy-pipe'

set -g allow-passthrough on

run-shell "tmux set-option -g default-shell $(command -v zsh)"

# give enough time to pick the fing pane
set -g display-panes-time 4000

set -g pane-border-lines double

#################
## KEYBINDINGS ##
#################
unbind C-b
set-option -g prefix C-a
bind C-a send-prefix

bind -n C-M-a run-shell "~/.local/bin/tmux-attach"

bind -n C-PPage previous-window
bind -n C-NPage next-window

# bind -n M-H resize-pane -L 2
# bind -n M-L resize-pane -R 2
# bind -n M-K resize-pane -U 2
# bind -n M-J resize-pane -D 2

bind  c  new-window      -c "#{pane_current_path}"
bind  %  split-window -h -c "#{pane_current_path}"
bind '"' split-window -v -c "#{pane_current_path}"

# Toggle '_' prefix on the current window name to hide/show it in the status bar
bind h run-shell 'tmux rename-window "#{?#{m:_*,#W},#{s/^_//:#W},_#W}"'

bind-key -n C-S-Left swap-window -t -1\; select-window -t -1
bind-key -n C-S-Right swap-window -t +1\; select-window -t +1

# Cycle real sessions with prefix + ( / ), skipping the per-session floating scratch sessions.
bind ( run-shell "~/.local/bin/tmux-session-cycle prev"
bind ) run-shell "~/.local/bin/tmux-session-cycle next"

# go to the top/first pane and maximize it
bind Z select-pane -t 1 \; resize-pane -Z

bind X confirm-before -p "kill session #S? (y/n)" kill-session

bind r source-file ~/.config/tmux/tmux.conf \; display "Config reloaded!"

#############
## PLUGINS ##
#############
set -g @plugin 'tmuxpack/tpack'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tmux-prefix-highlight'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'josemiguelo/tmux-floating-scratchpad'

set -g @floating_scratch_term 'C-t'
set -g @floating_scratch_width '95%'
set -g @floating_scratch_height '95%'
set -g @continuum-restore 'on'

#######################
## TOKYO NIGHT THEME ##
#######################

# Kitty carries the Tokyo Night palette in its ANSI slots and swaps storm for
# day with the system appearance (see kitty/*-theme.auto.conf). Naming slots
# rather than hex follows that switch.
#   color0 black   color1 red     color2 green  color3 yellow
#   color4 blue    color5 magenta color6 cyan   color8 bright black
#   color16 orange  color17 red (Tokyo Night's own, in the extended slots)

# Foreground for text on a bright accent. color0 is near black under storm but
# #b4b5b9 under day, so take it from client_theme instead. Comma-free so
# tmux-prefix-highlight can still split its own settings on commas.
set-option -g @fg_on_accent "#{?#{==:#{client_theme},light},#ffffff,color0}"

set-option -g status-style "bg=default"
set-option -g mode-style "bg=color8,fg=color15"

# Messages
set-option -g message-style "bg=default,fg=color4"
set-option -g message-command-style "bg=default,fg=color4"

# Panes
set-option -g pane-border-style "fg=color8"
set-option -g pane-active-border-style "fg=color4"
set-option -g display-panes-colour "color8"
set-option -g display-panes-active-colour "color4"

# Copy mode search
set-option -g copy-mode-match-style "bg=color3,fg=#{E:@fg_on_accent}"
set-option -g copy-mode-current-match-style "bg=color4,fg=#{E:@fg_on_accent}"

# Clock
set-option -g clock-mode-colour "color4"

# Center
set-option -g status-justify left
set-window-option -g window-status-current-format "#[range=window|#{window_index}]#{?#{m:_*,#W},,#[fg=color4]#[bg=default]▐#[fg=#{E:@fg_on_accent}]#[bg=color4]#[bold] #I #W #{?window_zoomed_flag,(ZOOMED),} #[fg=color4]#[bg=default]▌}#[norange]"
set-window-option -g window-status-format "#[range=window|#{window_index}]#{?#{m:_*,#W},, #I #W }#[norange]"

set-window-option -g window-status-separator ' '
set-window-option -g window-status-style "bg=default"
set-window-option -g window-status-activity-style "bg=default,fg=color3"
set-window-option -g window-status-bell-style "bg=default,fg=color1,bold"

# Left
set-option -g status-left '#{prefix_highlight}'
# the plugin builds its style by splitting this on commas, so bold rides along on fg
set -g @prefix_highlight_fg '#{E:@fg_on_accent},bold'
# Red, not cyan: cyan sits ~20 degrees from the active window's blue. color17
# over color1 because storm's #f7768e reads pink rather than red.
set -g @prefix_highlight_bg 'colour17'
set -g @prefix_highlight_show_copy_mode 'on'
set -g @prefix_highlight_copy_mode_attr 'fg=#{E:@fg_on_accent},bg=color3,bold'
set -g @prefix_highlight_show_sync_mode 'on'
set -g @prefix_highlight_sync_mode_attr 'fg=#{E:@fg_on_accent},bg=color2'
set -g @prefix_highlight_copy_prompt 'COPY'
set -g @prefix_highlight_sync_prompt 'SYNC'

# Right
set-option -g status-right "#[fg=#{E:@fg_on_accent},bg=color5,bold] #S #[default]"

# Status bar
# 1. Enable two lines for the status bar
# 2. Set the top line (index 0) to be the "padding" line (as an empty line)
# 3. Move your existing status content to the bottom line (index 1)
set -g status 2
set -g status-format[0] ""
set -g status-format[1] "#[align=left]#{E:status-left}#[align=left]#{W:#{T:window-status-format},#{T:window-status-current-format}#[default]}#[align=right]#{E:status-right}"

##########
## INIT ##
##########
run 'tpack init'
