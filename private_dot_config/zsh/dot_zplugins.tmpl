# brew
# must come first: it puts /opt/homebrew/bin on PATH, and plugins that shell out
# to a tool otherwise hit the much slower /usr/bin stubs (Apple git is ~300ms)
$ZDOTDIR/plugins/brew

# requirements
mattmc3/zfunctions

# ohmyzsh's lib, minus the pieces only its own themes use. starship draws the
# prompt, so async_prompt/prompt_info_functions/vcs_info/spectrum are dead
# weight, and bzr/nvm cover tools that aren't installed. clipboard.zsh is loaded
# further down with the plugins that depend on it.
ohmyzsh/ohmyzsh path:lib/cli.zsh
ohmyzsh/ohmyzsh path:lib/compfix.zsh
ohmyzsh/ohmyzsh path:lib/completion.zsh
ohmyzsh/ohmyzsh path:lib/correction.zsh
ohmyzsh/ohmyzsh path:lib/diagnostics.zsh
ohmyzsh/ohmyzsh path:lib/directories.zsh
ohmyzsh/ohmyzsh path:lib/functions.zsh
ohmyzsh/ohmyzsh path:lib/git.zsh
ohmyzsh/ohmyzsh path:lib/grep.zsh
ohmyzsh/ohmyzsh path:lib/history.zsh
ohmyzsh/ohmyzsh path:lib/key-bindings.zsh
ohmyzsh/ohmyzsh path:lib/misc.zsh
ohmyzsh/ohmyzsh path:lib/termsupport.zsh
ohmyzsh/ohmyzsh path:lib/theme-and-appearance.zsh

ohmyzsh/ohmyzsh path:plugins/extract

# completion utils
zsh-users/zsh-completions kind:fpath path:src
belak/zsh-utils path:completion
$ZDOTDIR/plugins/fzf
ohmyzsh/ohmyzsh path:plugins/fzf
Aloxaf/fzf-tab

# git
ohmyzsh/ohmyzsh path:plugins/git
$ZDOTDIR/completions/git kind:fpath

# asdf
# NOTE: asdf loading should not depend on any brew binary
# if this is the case, link it like: ln -s /opt/homebrew/bin/asdf ~/.local/bin/asdf
$ZDOTDIR/plugins/asdf-pre
$ZDOTDIR/plugins/asdf

# aliases utils
ohmyzsh/ohmyzsh path:plugins/alias-finder

# command not found utils
ohmyzsh/ohmyzsh path:plugins/command-not-found

# docker and k8s
$ZDOTDIR/plugins/docker
ohmyzsh/ohmyzsh path:plugins/docker-compose
ohmyzsh/ohmyzsh path:plugins/kubectl

# clipboard
ohmyzsh/ohmyzsh path:lib/clipboard.zsh
ohmyzsh/ohmyzsh path:plugins/copybuffer
ohmyzsh/ohmyzsh path:plugins/copyfile
ohmyzsh/ohmyzsh path:plugins/copypath

# Editor
ohmyzsh/ohmyzsh path:plugins/magic-enter

# tmux
$ZDOTDIR/plugins/tmux

# zshrc configs
mattmc3/zshrc.d

# dotfiles
$ZDOTDIR/plugins/chezmoi

# languages
$ZDOTDIR/plugins/golang
$ZDOTDIR/plugins/android
$ZDOTDIR/plugins/rust
$ZDOTDIR/plugins/java

# qmk
$ZDOTDIR/plugins/qmk

# highlighting
zdharma-continuum/fast-syntax-highlighting kind:defer

# suggestions 
zsh-users/zsh-autosuggestions kind:defer

# history
zsh-users/zsh-history-substring-search kind:defer
